@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="empty-state">
                <h2 class="mb-3">Access Denied</h2>
                <p class="mb-3">
                    Your account doesn't have permission to view that page. If you think this is
                    a mistake, check with a library administrator.
                </p>
                <a asp-action="Index" asp-controller="Dashboard" class="btn btn-brass">Back to Dashboard</a>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Reset Link Ready";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h4>Reset Link Ready</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.DevResetLink != null)
                    {
                        <p>
                            This project doesn't have an email service configured, so instead of
                            emailing you a link, here it is directly:
                        </p>
                        <div class="announcement announcement--info">
                            <a href="@ViewBag.DevResetLink" class="text-break">@ViewBag.DevResetLink</a>
                        </div>
                        <p class="text-muted small mb-0">
                            In a production app, this link would be emailed to you instead of shown
                            on screen.
                        </p>
                    }
                    else
                    {
                        <p class="mb-0">
                            If an account exists with that email, a password reset link has been
                            generated for it.
                        </p>
                    }
                </div>
            </div>
            <p class="text-center mt-3">
                <a asp-action="Index" asp-controller="Login">Back to login</a>
            </p>
        </div>
    </div>
</div>
